# Copier ce fichier en .env puis remplacer toutes les valeurs CHANGE_ME
# Le mot de passe de POSTGRES_PASSWORD doit être le même que dans DATABASE_URL

POSTGRES_USER=conformiia
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=conformiia

DATABASE_URL=postgresql+psycopg2://conformiia:CHANGE_ME@db:5432/conformiia
SECRET_KEY=CHANGE_ME
ENVIRONMENT=development

APP_BASE_URL=https://conformiia
API_BASE_URL=https://api.conformiia
ADMIN_EMAILS=admin@example.com

